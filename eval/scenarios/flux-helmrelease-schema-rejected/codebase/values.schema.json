{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "resources"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": {"type": "string"},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "paymentProvider": {
      "type": "object",
      "properties": {
        "endpoint": {"type": "string", "format": "uri"},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "maxRetries": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {"$ref": "#/definitions/quantities"},
        "limits": {"$ref": "#/definitions/quantities"}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": ["integer", "string"]}
      }
    }
  },
  "definitions": {
    "quantities": {
      "type": "object",
      "properties": {
        "cpu": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?m?$"},
        "memory": {"type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi)$"}
      }
    }
  }
}
