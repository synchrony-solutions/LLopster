# Claude access. LLM_PROVIDER=anthropic (default) uses ANTHROPIC_API_KEY;
# LLM_PROVIDER=bedrock routes Claude through AWS Bedrock (no key needed —
# set AWS_REGION + the BEDROCK_* model IDs, and supply creds via IRSA or the
# static AWS_* keys below). See README "Using AWS Bedrock".
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# AWS Bedrock (only when LLM_PROVIDER=bedrock)
# AWS_REGION=us-east-1
# BEDROCK_MODEL=us.anthropic.claude-opus-4-7-v1:0
# BEDROCK_TRIAGE_MODEL=us.anthropic.claude-haiku-4-5-v1:0
# BEDROCK_INVESTIGATION_MODEL=us.anthropic.claude-sonnet-4-6-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Notifications: NOTIFIER_PROVIDER=slack (default) | teams | none
NOTIFIER_PROVIDER=slack
SLACK_WEBHOOK_URL=
# For Microsoft Teams: set NOTIFIER_PROVIDER=teams and the Power Automate
# Workflows incoming-webhook URL below.
# TEAMS_WEBHOOK_URL=

# Local stack endpoints
LOKI_URL=http://localhost:3100
PROMETHEUS_URL=http://localhost:9090

# Alert context window
LOG_LOOKBACK_MINUTES=30
MAX_LOG_LINES=200

GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Use the 1-hour prompt-cache TTL beta. Set to false if your Anthropic
# account doesn't have the extended-cache-ttl beta enabled (otherwise every
# investigation/synthesis call 400s).
EXTENDED_CACHE_TTL=true

# Signed license JWT that unlocks paid (Business/Enterprise) features. Empty
# = full Community tier (gates nothing). Can also be set/cleared from the
# dashboard (Settings -> License) without a redeploy.
LLOPSTER_LICENSE_KEY=

# Inbound-surface authentication. Shared secret guarding /webhook, the
# manual-trigger routes, and the dashboard settings/license mutations. EMPTY =
# auth DISABLED (a loud startup warning is logged) — fine for local eval, but
# set a strong random value before exposing the agent/dashboard anywhere
# untrusted. Clients send it as `Authorization: Bearer <token>` or HTTP Basic
# (password component). AlertManager must be configured with a matching bearer
# token. A value pasted in the dashboard (Settings → API access) overrides this.
LLOPSTER_API_TOKEN=

# Least-privilege posture: open LLM-authored PRs as drafts for human review.
# Set to false to open ready-for-review PRs.
OPEN_PRS_AS_DRAFT=true

# Automatic cost circuit breaker. When runs-created-per-hour or estimated
# synthesis spend-per-day reaches a ceiling, the agent trips into manual mode
# (new alerts park at `queued`) and stops spending until an operator steps in.
# These ship NON-ZERO so there's an out-of-the-box spend cap — tune them to your
# alert volume / budget. Set a ceiling to 0 to disable it.
MAX_RUNS_PER_HOUR=50
MAX_USD_PER_DAY=25

# Post-firing backoff (minutes). After an alert's pipeline finishes WITHOUT
# opening a PR (below the confidence threshold, or no actionable patch), suppress
# repeated firings of that same alert for this long — one re-investigation per
# window — so a flapping unfixable alert doesn't re-run the full pipeline every
# time. 0 = disabled.
PATCH_BACKOFF_MINUTES=60
